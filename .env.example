# Server-side only. Never commit a real .env file.

# Required. Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Optional. Enables the admin-only reliability dashboard at /eval and its APIs.
# Use a random string of 24+ characters (e.g. `openssl rand -hex 24`). Unset = dashboard disabled.
EVAL_ADMIN_TOKEN=

# Optional. Where evaluation runs are saved. On Render, point this at a persistent disk
# (e.g. /var/data/eval-runs) or results are lost on each deploy/restart.
EVAL_RESULTS_DIR=

# Optional. Current Sarvam prices for cost estimates in live evaluations. Leave unset to show
# "Unavailable" instead of a guess. Example:
# EVAL_PRICING_JSON={"currency":"INR","models":{"sarvam-105b":{"input":0,"output":0},"sarvam-30b":{"input":0,"output":0}},"ocrPerPage":0}
EVAL_PRICING_JSON=

# Optional. Set to 1 to disable the in-memory rate limiter (tests/local load testing only).
RATE_LIMIT_DISABLED=
