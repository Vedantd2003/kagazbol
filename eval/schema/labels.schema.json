{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KagazBol Eval Labels",
  "type": "object",
  "required": ["doc_id", "doc_type", "language", "fields", "qa_pairs"],
  "properties": {
    "doc_id": { "type": "string" },
    "doc_type": { "type": "string", "enum": ["electricity_bill", "prescription", "bank_notice", "other"] },
    "language": { "type": "string", "enum": ["en-IN", "hi-IN", "mr-IN"] },
    "is_synthetic": { "type": "boolean" },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "value"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["amount", "date", "name", "id", "text"] },
          "value": { "type": "string" }
        }
      }
    },
    "qa_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer", "supporting_text"],
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" },
          "supporting_text": { "type": "string" }
        }
      }
    }
  }
}
